package-as: ItemNotesForever

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Addon sources live in addon/; lift them to the top of the packaged folder.
move-folders:
  ItemNotesForever/addon: ItemNotesForever

# Dotfiles (.luacheckrc, .gitignore, ...) are ignored automatically.
ignore:
  - README.md
  - art
  - screenshots
  - tests
